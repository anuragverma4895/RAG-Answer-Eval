# Backend configuration — store your real key only in the ignored root .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local data paths (relative to this repository root).
VECTOR_DB_PATH=./backend/data/chroma
SQLITE_PATH=./backend/data/rag_eval.db

# Retrieval and document-processing settings.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.25
MAX_UPLOAD_MB=15
