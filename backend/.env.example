# Backend configuration. Copy this file to backend/.env and add your Gemini API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local persistence paths are resolved relative to the repository root.
VECTOR_DB_PATH=./backend/data/chroma
SQLITE_PATH=./backend/data/rag_eval.db

# Retrieval and document-processing settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.25
MAX_UPLOAD_MB=15
